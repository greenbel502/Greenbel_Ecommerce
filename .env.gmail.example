# Server-only. APP_ENV selects exactly DEV or PROD; there is no fallback.
# Local development: APP_ENV=DEV. Do not put any of these in NEXT_PUBLIC_.
GOOGLE_GMAIL_DEV_CLIENT_ID=
GOOGLE_GMAIL_DEV_CLIENT_SECRET=
GOOGLE_GMAIL_DEV_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_SENDER_DEV_EMAIL=
GMAIL_NOTIFICATION_DEV_EMAIL=

# Vercel Production: APP_ENV=PROD. Configure the PROD group plus the common key.
GOOGLE_GMAIL_PROD_CLIENT_ID=
GOOGLE_GMAIL_PROD_CLIENT_SECRET=
GOOGLE_GMAIL_PROD_REDIRECT_URI=https://www.greenbel.store/api/integrations/gmail/callback
GMAIL_SENDER_PROD_EMAIL=
GMAIL_NOTIFICATION_PROD_EMAIL=

# Common variable name, configured privately for each deployment.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Encryption key: exactly 32 random bytes encoded as standard Base64.
# Preserve existing key values when renaming; changing one requires reconnecting Gmail.
# These clients authorize sending Gmail only. Google sign-in is configured separately
# in Supabase Authentication > Providers > Google, for each Supabase project.
# Keep existing APP_ENV/Supabase selectors. Financing requires approved migrations
# 030 + 031 and a cooperative primary email. It uses the Supabase account session;
# FINANCING_OTP_HMAC_KEY is no longer used by financing.
# Publish the two public brand images with scripts/dev-publish-mail-assets.mjs
# in DEV. Provision equivalent email-assets objects separately before PROD use.
