# Server-only. Copy into your private local environment or Vercel Environment Variables.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_SENDER_EMAIL=
GMAIL_NOTIFICATION_EMAIL=
# Exactly 32 random bytes encoded as standard Base64. Use a different key in DEV and PROD.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Production callback (set only in Vercel Production):
# GOOGLE_GMAIL_REDIRECT_URI=https://green-bel.vercel.app/api/integrations/gmail/callback
# Keep existing APP_ENV/Supabase selectors. Financing requires approved migrations
# 030 + 031 and a cooperative primary email. It uses the Supabase account session;
# FINANCING_OTP_HMAC_KEY is no longer used by financing.
# Publish the two public brand images with scripts/dev-publish-mail-assets.mjs
# in DEV. Provision equivalent email-assets objects separately before PROD use.
